# Anthropic API key used to generate apps. Without it BuildIT runs in "template mode"
# and scaffolds a generic CRUD app instead of calling Claude.
ANTHROPIC_API_KEY=
# Model used for app generation
BUILDIT_MODEL=claude-opus-5-5
PORT=3000
# Where the SQLite database lives
DATA_DIR=./data
# Optional: serve deployed apps on their own subdomain (e.g. "apps.example.com" -> https://myapp.apps.example.com).
# For local dev "localhost:3000" works in most browsers (http://myapp.localhost:3000).
# When unset, deployed apps are served at /apps/<slug>/ inside a CSP sandbox.
APPS_DOMAIN=
# Public base URL of the platform (used to build links)
PUBLIC_URL=http://localhost:3000
# Who may create a builder account: emails and/or "@domain" entries, comma separated
# (e.g. "me@gmail.com, @mycompany.com"). Empty = anyone. Invited emails can always sign up.
ALLOWED_SIGNUP_EMAILS=
