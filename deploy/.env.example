# The domain BuildIT runs on (no https://). Point an A record for it at this server.
BUILDIT_DOMAIN=trunrthweb.com
PUBLIC_URL=https://trunrthweb.com

# Published apps live at <app>.apps.trunrthweb.com.
# Needs a wildcard A record: *.apps.trunrthweb.com -> this server.
APPS_DOMAIN=apps.trunrthweb.com

# Who may create a builder account: emails and/or whole domains, comma separated.
# e.g. "me@gmail.com, @mycompany.com". People you invite to a workspace can always sign up.
# Leave empty to let anyone sign up (they'd spend your Anthropic credits).
ALLOWED_SIGNUP_EMAILS=

# Enables app generation with Claude.
ANTHROPIC_API_KEY=
BUILDIT_MODEL=claude-opus-5-5
